#!/command/with-contenv bashio
# shellcheck shell=bash
# vim: ft=bash
# ==============================================================================
# Start srat service
# ==============================================================================
set -euo pipefail
exec 2>&1
trap 'bashio::log.error "srat/run failed at line ${BASH_LINENO[0]} (exit code: ${?})"' ERR

export HOSTNAME
export ADDON_VERSION=$(bashio::app.version)

# Hosted OAuth broker for the rclone cloud-sync lab feature (issue #954).
# Exported unconditionally so resolution is centralized in SRAT:
#   empty  ≡ unset → SRAT's baked-in default applies
#   "off"          → hosted flow explicitly disabled
#   value          → overrides the default
export SRAT_OAUTH_BROKER_URL="$(bashio::config 'srat_oauth_broker_url' '')"
case "${SRAT_OAUTH_BROKER_URL,,}" in
  "") ;;
  off) bashio::log.info "SRAT OAuth broker disabled via sentinel" ;;
  *) bashio::log.info "SRAT OAuth broker override active" ;;
esac

ipaddress=$(bashio::app.ip_address)

#bashio::log.info "Wait Samba Server to going up..(max 60s)"
#bashio::net.wait_for 445 ${ipaddress/\/*/} 60

# Read hostname from API or setting default "hassio"
HOSTNAME=$(bashio::info.hostname)
if bashio::var.is_empty "${HOSTNAME}" || [ "${HOSTNAME}" == "null" ]; then
  bashio::log.warning "Can't read hostname, using default."
  HOSTNAME="homeassistant"
fi
bashio::log.debug "Hostname: ${HOSTNAME} Addon Version: ${ADDON_VERSION}"

SRAT_ARGS="-port $(bashio::app.ingress_port) \
  $(if [[ "$(bashio::app.protected)" == "true" ]]; then echo "-protected-mode"; fi) \
  $(bashio::config.true 'leave_front_door_open' || echo " -addon") \
  -db /config/config.db3 \
  -out /etc/samba/smb.conf \
  -docker-interface "$(bashio::network 'network.info.docker.inerface' '.docker.interface')" \
  -docker-network "$(bashio::network 'network.info.docker.network' '.docker.address')" \
  -loglevel $(bashio::config 'log_level' 'info') \
  -update-channel $(bashio::config 'srat_update_channel' 'none') \
  -ip-address $(bashio::app.ip_address) \
  -upgrade-data-dir $(bashio::config.equals 'srat_update_channel' 'develop' && echo '/config/upgrade' || echo '/data/upgrade')"

# Check if --auto-update flag is supported and add it if auto_update is true
if bashio::config.true 'auto_update'; then
  help_text=$(/usr/local/bin/srat-server --help 2>&1 || true)
  if echo "${help_text}" | grep -q -- '--auto-update'; then
    SRAT_ARGS="${SRAT_ARGS} --auto-update"
  fi
fi
  
if bashio::config.true 'disable_ipv6'; then
  help_text=$(/usr/local/bin/srat-server --help 2>&1 || true)
  if echo "${help_text}" | grep -q -- '--ipv4-only'; then
    SRAT_ARGS="${SRAT_ARGS} --ipv4-only"
  elif echo "${help_text}" | grep -q -- ' -4'; then
    SRAT_ARGS="${SRAT_ARGS} -4"
  else
    bashio::log.warning "wsddn IPv4-only flag not detected; relying on IPv6 sysctl disable"
  fi
fi

# Detect best binary variant for this system
if [ -x /usr/local/bin/srat-server-musl ] && [ -f /lib/ld-musl-*.so.* ]; then
  exec /usr/local/bin/srat-server-musl ${SRAT_ARGS}
elif [ -x /usr/local/bin/srat-server-glib ] && [ -f /lib64/ld-linux-*.so.* ]; then
  exec /usr/local/bin/srat-server-glib ${SRAT_ARGS}
else
  exec /usr/local/bin/srat-server ${SRAT_ARGS}
fi
